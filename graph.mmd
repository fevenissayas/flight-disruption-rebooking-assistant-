---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classifier(classifier)
	rebooking(rebooking)
	tools(tools)
	refund(refund)
	compensation(compensation)
	policy_checker(policy_checker)
	escalation(escalation)
	final_response(final_response)
	__end__([<p>__end__</p>]):::last
	__start__ --> classifier;
	classifier -.-> compensation;
	classifier -.-> escalation;
	classifier -.-> rebooking;
	classifier -.-> refund;
	compensation --> policy_checker;
	escalation --> final_response;
	policy_checker -.-> compensation;
	policy_checker -.-> escalation;
	policy_checker -.-> final_response;
	policy_checker -.-> rebooking;
	policy_checker -.-> refund;
	rebooking -. &nbsp;__end__&nbsp; .-> policy_checker;
	rebooking -.-> tools;
	refund --> policy_checker;
	tools --> rebooking;
	final_response --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
